{
  "name": "attention-plugins",
  "version": "0.2.0",
  "description": "DSH task-priority session notifications: main-line tasks alert immediately, side-line completions can be batched, plus questions and permission requests.",
  "author": "zjbc2000",
  "type": "module",
  "main": "lib/index.js",
  "types": "lib/types/index.d.ts",
  "exports": {
    ".": {
      "types": "./lib/types/index.d.ts",
      "default": "./lib/index.js"
    },
    "./client": {
      "types": "./lib/types/client/index.d.ts",
      "default": "./lib/client.js"
    },
    "./cordis.patch.yml": "./cordis.patch.yml",
    "./package.json": "./package.json"
  },
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "client": {
      "inject": [
        "@deepseek-ai/dsh-client-ui-renderer",
        "@deepseek-ai/dsh-client-locale",
        "@deepseek-ai/dsh-client-ui-settings",
        "@deepseek-ai/dsh-client-ui-slots",
        "@deepseek-ai/dsh-api-session-controller",
        "@deepseek-ai/dsh-client-ui-session"
      ],
      "platform": "web"
    }
  },
  "scripts": {
    "build": "tsc -p tsconfig.json && node bundle-client.mjs",
    "bundle:client": "node bundle-client.mjs",
    "watch": "tsc -p tsconfig.json --watch",
    "clean": "rm -rf lib",
    "test": "vitest run",
    "test:watch": "vitest",
    "prepublishOnly": "npm test && npm run build"
  },
  "engines": {
    "node": ">=20",
    "dsh": ">=0.1.7"
  },
  "devDependencies": {
    "@deepseek-ai/cordis": "^4.0.4",
    "@deepseek-ai/dsh-api-session-controller": "^0.1.7-rc.2",
    "@deepseek-ai/dsh-client-connection": "^0.1.7-rc.2",
    "@deepseek-ai/dsh-client-locale": "^0.1.7-rc.2",
    "@deepseek-ai/dsh-client-store": "^0.1.7-rc.2",
    "@deepseek-ai/dsh-client-ui-primitives": "^0.1.7-rc.2",
    "@deepseek-ai/dsh-client-ui-renderer": "^0.1.7-rc.2",
    "@deepseek-ai/dsh-client-ui-session": "^0.1.7-rc.2",
    "@deepseek-ai/dsh-client-ui-settings": "^0.1.7-rc.2",
    "@deepseek-ai/dsh-client-ui-slots": "^0.1.7-rc.2",
    "@deepseek-ai/dsh-settings": "^0.1.7-rc.2",
    "@deepseek-ai/schemastery": "^3.18.1",
    "@types/node": "^24.0.0",
    "@types/react": "~18.3.1",
    "react": "^18.2.0",
    "typescript": "^6.0.3",
    "vitest": "^5.0.1"
  },
  "peerDependencies": {
    "@deepseek-ai/cordis": "^4.0.1",
    "react": "^18.2.0"
  },
  "license": "MIT",
  "files": [
    "lib",
    "src",
    "docs",
    "cordis.patch.yml",
    "README.md",
    "CHANGELOG.md",
    "LICENSE"
  ],
  "keywords": [
    "dsh-plugin",
    "deepseek-harness",
    "deepseek",
    "dsh",
    "notification",
    "notifications",
    "attention",
    "mainline",
    "session",
    "productivity",
    "alert",
    "sound",
    "browser-notification",
    "task-management"
  ],
  "repository": {
    "type": "git",
    "url": "https://github.com/zjbc2000/attention-plugins.git"
  },
  "bugs": {
    "url": "https://github.com/zjbc2000/attention-plugins/issues"
  },
  "homepage": "https://github.com/zjbc2000/attention-plugins#readme"
}
